NODE_ENV=development
PORT=3000

BASE_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=service_job_management

# ---------- JWT ----------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# ---------- Admin registration ----------

ADMIN_REGISTRATION_KEY=change-me-admin-key

# ---------- Seed admin (npm run seed:admin) ----------
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# ---------- Uploads ----------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ---------- Business ----------
GST_PERCENT=10
